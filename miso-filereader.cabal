cabal-version:      3.0
name:               miso-filereader
version:            0.1.0.0
synopsis:           A miso FileReader example
description:        Read a text file in the browser with miso
license:            BSD-3-Clause
author:             dmjio
maintainer:         code@dmj.io
copyright:          haskell-miso @ 2026
category:           Web
build-type:         Simple

common warnings
  ghc-options:
    -funbox-strict-fields -O2 -ferror-spans -fspecialise-aggressively -Wall

common options
  if arch(wasm32)
    ghc-options:
      -no-hs-main -optl-mexec-model=reactor "-optl-Wl,--export=hs_start"
    cpp-options:
      -DWASM

executable app
  import:
    options, warnings
  main-is:
    Main.hs
  build-depends:
    base < 5, miso >= 1.14
  hs-source-dirs:
    src
  default-language:
    Haskell2010
